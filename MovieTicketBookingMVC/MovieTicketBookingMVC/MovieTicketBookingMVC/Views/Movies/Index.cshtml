@model IEnumerable<MovieTicketBookingMVC.Models.Movie>
@{
    ViewBag.Title = "Movies";
}
<div class="page-intro"><p class="eyebrow">FIND YOUR FILM</p><h1>Now showing</h1><p>Pick a movie, choose a show, and make it a movie night.</p></div>
@using (Html.BeginForm("Index", "Movies", FormMethod.Get, new { @class = "filter-bar" }))
{
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Search title or language..." />
    <select name="genre"><option value="">All genres</option>
    @foreach (var g in (IEnumerable<string>)ViewBag.Genres) { <option value="@g" @(Request.QueryString["genre"] == g ? "selected" : "")>@g</option> }
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
}
<div class="movie-grid">
@foreach (var movie in Model)
{
    <article class="movie-card">
        <a class="poster-wrap" href="@Url.Action("Details", "Movies", new { id = movie.MovieId })"><img src="@movie.PosterUrl" alt="@movie.Title poster" onerror="this.style.display='none';this.parentElement.classList.add('poster-fallback');" /><span class="poster-label">@movie.Language</span></a>
        <div class="movie-info"><div class="movie-meta"><span>@movie.Genre</span><span>@movie.DurationMinutes min</span></div><h3>@movie.Title</h3><p>@movie.Language</p><div class="movie-card-bottom"><strong>₹@movie.TicketPrice.ToString("0.00")</strong>@Html.ActionLink("Details", "Details", new { id = movie.MovieId }, new { @class = "btn btn-small btn-outline" })</div></div>
    </article>
}
</div>
@if (!Model.Any()) { <div class="empty-state"><h3>No movies found</h3><p>Try a different search.</p></div> }
